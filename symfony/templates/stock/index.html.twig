<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manucurist — Gestion du stock</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <span class="navbar-brand">
            Manucurist — Gestion du stock
        </span>
    </div>
</nav>

<main class="container pb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Catalogue produits</h1>
            <p class="text-muted mb-0">
                Consultez les stocks et enregistrez vos ventes.
            </p>
        </div>

        <a href="{{ path('stock_index') }}" class="btn btn-outline-dark">
            Réinitialiser
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('stock_index') }}"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label for="shade" class="form-label">Filtrer par teinte</label>
                    <input
                        id="shade"
                        type="text"
                        name="shade"
                        class="form-control"
                        value="{{ shade ?? '' }}"
                        placeholder="Ex. rouge"
                    >
                </div>

                <div class="col-md-4">
                    <div class="form-check mb-2">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="alert"
                            name="alert"
                            value="1"
                            {% if alert %}checked{% endif %}
                        >
                        <label class="form-check-label" for="alert">
                            Produits en alerte uniquement
                        </label>
                    </div>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">
                        Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Produit</th>
                    <th>Teinte</th>
                    <th>Prix HT</th>
                    <th>Stock</th>
                    <th>Seuil</th>
                    <th>État</th>
                    <th>Enregistrer une vente</th>
                </tr>
                </thead>

                <tbody>
                {% for product in products %}
                    <tr>
                        <td>{{ product.id }}</td>
                        <td>{{ product.name }}</td>
                        <td>{{ product.shade }}</td>
                        <td>{{ product.priceHt|number_format(2, ',', ' ') }} €</td>
                        <td>
                            <strong>{{ product.stock }}</strong>
                        </td>
                        <td>{{ product.alertThreshold }}</td>

                        <td>
                            {% if product.stock < product.alertThreshold %}
                                <span class="badge bg-danger">Alerte</span>
                            {% else %}
                                <span class="badge bg-success">Disponible</span>
                            {% endif %}
                        </td>
                        <td>
                            <form
                                method="post"
                                action="{{ path('stock_sell', {id: product.id}) }}"
                                class="d-flex gap-2"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('sell_product_' ~ product.id) }}"
                                >

                                <input
                                    type="number"
                                    name="quantity"
                                    class="form-control form-control-sm"
                                    min="1"
                                    max="{{ product.stock }}"
                                    value="1"
                                    required
                                    aria-label="Quantité à vendre"
                                    style="width: 85px"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-primary"
                                    {% if product.stock <= 0 %}disabled{% endif %}
                                >
                                    Vendre
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Aucun produit trouvé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

